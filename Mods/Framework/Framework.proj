<Project DefaultTargets="Build">
    <Import Project="..\..\Directory.Build.props" />
    <PropertyGroup>
        <ModName>MEMORIA</ModName>
        <PackageId>memoria</PackageId>
        <PackageDisplayName>Memoria Framework</PackageDisplayName>
    </PropertyGroup>
    <PropertyGroup Label="Steam Workshop">
        <!-- Set this to the ID of the existing Workshop item. Leaving it empty prevents accidental item creation. -->
        <WorkshopPublishedFileId />
        <!-- SteamCMD cannot apply tags; keep this value in sync with the category selected on the Workshop page. -->
        <WorkshopTags>override</WorkshopTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Tools\Toolset\Memoria.NeverwinterNights.Toolset.csproj" />
        <NwnSource Include="source\**\*.nss" />
        <NwnPackageFile Include="source\**\*.nss" />
        <NwnResource Include="resources\**\*" Exclude="resources\**\.gitkeep" />
        <PackageDocument Include="*.md" />
    </ItemGroup>
    <Import Project="..\..\Build\NwnModProject.targets" />
</Project>
