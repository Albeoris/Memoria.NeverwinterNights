{
  "screen": {
    "width": 1920,
    "height": 1080,
    "uiScale": 2.0
  },
  "window": {
    "coverage": 0.9,
    "logicalWidth": 560,
    "logicalHeight": 224,
    "titleHeight": 24,
    "padding": 8
  },
  "root": {
    "id": "priority-editor",
    "type": "column",
    "gap": 0,
    "minimumSlack": 8,
    "children": [
      {
        "id": "criterion",
        "type": "row",
        "height": 30,
        "children": [
          { "id": "criterion-label", "width": 120 },
          { "id": "criterion-combo", "width": 390 }
        ]
      },
      {
        "id": "dynamic-details",
        "type": "group",
        "height": 36,
        "borderInset": 0,
        "scrollbars": "none",
        "child": {
          "id": "widest-details",
          "type": "row",
          "height": 30,
          "children": [
            { "id": "comparison-label", "width": 95 },
            { "id": "comparison", "width": 135 },
            { "id": "threshold-label", "width": 85 },
            { "id": "threshold", "width": 195 }
          ]
        }
      },
      { "id": "enabled", "type": "control", "height": 28 },
      { "id": "operations", "type": "control", "height": 32 },
      { "id": "save-cancel", "type": "control", "height": 32 }
    ]
  }
}
