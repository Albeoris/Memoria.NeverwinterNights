<Project DefaultTargets="Build">
  <Import Project="..\..\Directory.Build.props" />
  <PropertyGroup>
    <ModName>MECALM</ModName>
    <PackageId>mecalm</PackageId>
    <PackageDisplayName>Memoria Companion Auto-Lock Manager (MECALM)</PackageDisplayName>
  </PropertyGroup>
  <PropertyGroup Label="Steam Workshop">
    <!-- Set this to the ID of the existing Workshop item. Leaving it empty prevents accidental item creation. -->
    <WorkshopPublishedFileId />
    <!-- SteamCMD cannot apply tags; keep this value in sync with the category selected on the Workshop page. -->
    <WorkshopTags>override</WorkshopTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Tools\Toolset\Memoria.NeverwinterNights.Toolset.csproj" />
    <NwnSource Include="source\**\*.nss" />
    <NwnResource Include="resources\**\*" Exclude="resources\**\.gitkeep" />
    <NwnIncludeDirectory Include="..\EventScriptInjector\source;..\Framework\source" />
    <PackageDocument Include="*.md" />
    <NwnRequiredPackage Include="..\Bootstrapper\Bootstrapper.proj" PackageName="Memoria Bootstrapper" />
    <NwnRequiredPackage Include="..\EventScriptInjector\EventScriptInjector.proj" PackageName="Event Script Injector (Memoria Edition)" />
    <NwnRequiredPackage Include="..\Configuration\Configuration.proj" PackageName="Memoria Configuration Manager" />
  </ItemGroup>
  <Import Project="..\..\Build\NwnModProject.targets" />
</Project>
