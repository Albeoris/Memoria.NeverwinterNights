void main()
{
    int iKey = StringToInt(GetScriptParam("MECALM_TEXT_KEY"));
    string sText = iKey == 1 ? "Automatic Lockpicking" : iKey == 2 ? "Activate this item to enable or disable automatic lockpicking by companions. The safety manager that stops companions from attacking locks and traps being worked on is always active." : iKey == 3 ? "Automatic lockpicking: enabled." : iKey == 4 ? "Automatic lockpicking: disabled." : iKey == 5 ? "Automatic lockpicking is paused while you directly control your familiar." : iKey == 6 ? "No companion could reach the lock; task released:" : iKey == 7 ? "Companion Auto-Lock Manager installed, version" : iKey == 8 ? "MECALM scan: eligible visible locks = " : iKey == 9 ? ", available locksmiths = " : iKey == 10 ? "ON" : iKey == 11 ? "OFF" : iKey == 12 ? "I'll pick this lock!" : iKey == 13 ? "MECALM Settings" : iKey == 14 ? "Automatic lockpicking" : iKey == 15 ? "Enabled" : iKey == 16 ? "Search radius (1-100 m)" : iKey == 17 ? "LOS/task interval (0.1-6 s)" : iKey == 18 ? "Require line of sight" : iKey == 19 ? "Prevent attacks on worked locks" : iKey == 20 ? "Grey highlight for detected locks" : iKey == 21 ? "Companion overhead messages" : iKey == 22 ? "Debug output" : iKey == 23 ? "Automatic Detect mode" : iKey == 24 ? "Movement check interval (0.1-6 s)" : iKey == 25 ? "Stationary delay (0.1-30 s)" : iKey == 26 ? "Save" : iKey == 27 ? "Cancel" : iKey == 28 ? "Invalid value. Use numbers within the ranges shown." : iKey == 29 ? "MECALM settings saved." : "";
    SetLocalString(OBJECT_SELF, "MECALM_TEXT_RESULT", sText);
}
