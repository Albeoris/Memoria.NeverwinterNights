void main()
{
    int iKey = StringToInt(GetScriptParam("MECALM_TEXT_KEY"));
    string sText = iKey == 1 ? "Forzar cerraduras automáticamente" : iKey == 2 ? "Activa este objeto para habilitar o deshabilitar que los compañeros fuercen cerraduras automáticamente. El gestor de seguridad que impide que ataquen cerraduras y trampas manipuladas está siempre activo." : iKey == 3 ? "Forzado automático de cerraduras: activado." : iKey == 4 ? "Forzado automático de cerraduras: desactivado." : iKey == 5 ? "El forzado automático está en pausa mientras controlas directamente a tu familiar." : iKey == 6 ? "Ningún compañero pudo llegar a la cerradura; tarea cancelada:" : iKey == 7 ? "Gestor automático de cerraduras instalado, versión" : iKey == 8 ? "Diagnóstico MECALM: cerraduras visibles aptas = " : iKey == 9 ? ", compañeros disponibles = " : iKey == 10 ? "ACTIVO" : iKey == 11 ? "INACTIVO" : iKey == 12 ? "¡Yo forzaré esta cerradura!" : iKey == 13 ? "Gestor automático de cerraduras" : iKey == 14 ? "Forzado automático de cerraduras" : iKey == 15 ? "Activado" : iKey == 16 ? "Radio de búsqueda (1-100 m)" : iKey == 17 ? "Intervalo de visión/tareas (0.1-6 s)" : iKey == 18 ? "Exigir línea de visión" : iKey == 19 ? "Impedir ataques a cerraduras manipuladas" : iKey == 20 ? "Resaltar en gris las cerraduras detectadas" : iKey == 21 ? "Mensajes sobre los compañeros" : iKey == 22 ? "Salida de depuración" : iKey == 23 ? "Modo Detectar automático" : iKey == 24 ? "Intervalo de movimiento (0.1-6 s)" : iKey == 25 ? "Espera en reposo (0.1-30 s)" : iKey == 26 ? "Guardar" : iKey == 27 ? "Cancelar" : iKey == 28 ? "Valor no válido. Usa los intervalos indicados." : iKey == 29 ? "Ajustes de MECALM guardados." : "";
    SetLocalString(OBJECT_SELF, "MECALM_TEXT_RESULT", sText);
}
