void main()
{
    int iKey = StringToInt(GetScriptParam("MECALM_TEXT_KEY"));
    string sText = iKey == 1 ? "Automatisches Schlösserknacken" : iKey == 2 ? "Aktiviert oder deaktiviert das automatische Schlösserknacken durch Gefährten. Der Sicherheitsmanager, der Angriffe von Gefährten auf gerade bearbeitete Schlösser und Fallen verhindert, ist immer aktiv." : iKey == 3 ? "Automatisches Schlösserknacken: aktiviert." : iKey == 4 ? "Automatisches Schlösserknacken: deaktiviert." : iKey == 5 ? "Das automatische Schlösserknacken pausiert, während Ihr den Vertrauten direkt steuert." : iKey == 6 ? "Kein Gefährte konnte das Schloss erreichen; Auftrag abgebrochen:" : iKey == 7 ? "Manager für automatisches Schlösserknacken installiert, Version" : iKey == 8 ? "MECALM-Diagnose: geeignete sichtbare Schlösser = " : iKey == 9 ? ", verfügbare Schlossknacker = " : iKey == 10 ? "AN" : iKey == 11 ? "AUS" : iKey == 12 ? "Ich knacke dieses Schloss!" : iKey == 13 ? "Manager für automatisches Schlösserknacken" : iKey == 14 ? "Automatisches Schlösserknacken" : iKey == 15 ? "Aktiviert" : iKey == 16 ? "Suchradius (1-100 m)" : iKey == 17 ? "Sicht-/Auftragsintervall (0.1-6 s)" : iKey == 18 ? "Sichtlinie erforderlich" : iKey == 19 ? "Angriffe auf bearbeitete Schlösser verhindern" : iKey == 20 ? "Erkannte Schlösser grau hervorheben" : iKey == 21 ? "Meldungen über Gefährten" : iKey == 22 ? "Debug-Ausgabe" : iKey == 23 ? "Automatischer Suchmodus" : iKey == 24 ? "Bewegungsprüfintervall (0.1-6 s)" : iKey == 25 ? "Stillstandsverzögerung (0.1-30 s)" : iKey == 26 ? "Speichern" : iKey == 27 ? "Abbrechen" : iKey == 28 ? "Ungültiger Wert. Bitte die angezeigten Bereiche beachten." : iKey == 29 ? "MECALM-Einstellungen gespeichert." : "";
    SetLocalString(OBJECT_SELF, "MECALM_TEXT_RESULT", sText);
}
