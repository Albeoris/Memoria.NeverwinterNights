void main()
{
    int iKey = StringToInt(GetScriptParam("MECALM_TEXT_KEY"));
    string sText = iKey == 1 ? "Автоматический взлом замков" : iKey == 2 ? "Активируйте этот предмет, чтобы включить или выключить автоматический взлом замков напарниками. Защитный менеджер, не позволяющий напарникам атаковать замки и ловушки, с которыми работает группа, активен всегда." : iKey == 3 ? "Автоматический взлом замков включён." : iKey == 4 ? "Автоматический взлом замков выключен." : iKey == 5 ? "Автоматический взлом приостановлен, пока вы напрямую управляете фамильяром." : iKey == 6 ? "Никто из напарников не смог добраться до замка; задача отменена:" : iKey == 7 ? "Менеджер автоматического взлома установлен, версия" : iKey == 8 ? "Диагностика MECALM: подходящих видимых замков = " : iKey == 9 ? ", доступных взломщиков = " : iKey == 10 ? "ВКЛ" : iKey == 11 ? "ВЫКЛ" : iKey == 12 ? "Я это взломаю!" : iKey == 13 ? "Менеджер автоматического взлома" : iKey == 14 ? "Автоматический взлом" : iKey == 15 ? "Включено" : iKey == 16 ? "Радиус поиска (1-100 м)" : iKey == 17 ? "Интервал LOS и задач (0.1-6 с)" : iKey == 18 ? "Требовать прямую видимость" : iKey == 19 ? "Запрещать атаки по обрабатываемым замкам" : iKey == 20 ? "Серая подсветка обнаруженных замков" : iKey == 21 ? "Сообщения над головами спутников" : iKey == 22 ? "Отладочный вывод" : iKey == 23 ? "Автоматический режим обнаружения" : iKey == 24 ? "Интервал проверки движения (0.1-6 с)" : iKey == 25 ? "Задержка в покое (0.1-30 с)" : iKey == 26 ? "Сохранить" : iKey == 27 ? "Отмена" : iKey == 28 ? "Некорректное значение. Используйте числа в указанных диапазонах." : iKey == 29 ? "Настройки MECALM сохранены." : "";
    SetLocalString(OBJECT_SELF, "MECALM_TEXT_RESULT", sText);
}
