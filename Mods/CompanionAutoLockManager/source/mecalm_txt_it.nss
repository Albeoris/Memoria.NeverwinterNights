void main()
{
    int iKey = StringToInt(GetScriptParam("MECALM_TEXT_KEY"));
    string sText = iKey == 1 ? "Scassinamento automatico" : iKey == 2 ? "Attiva questo oggetto per abilitare o disabilitare lo scassinamento automatico dei compagni. Il gestore di sicurezza che impedisce ai compagni di attaccare serrature e trappole su cui sta lavorando il gruppo è sempre attivo." : iKey == 3 ? "Scassinamento automatico: attivato." : iKey == 4 ? "Scassinamento automatico: disattivato." : iKey == 5 ? "Lo scassinamento automatico è sospeso mentre controlli direttamente il famiglio." : iKey == 6 ? "Nessun compagno ha potuto raggiungere la serratura; incarico annullato:" : iKey == 7 ? "Gestore dello scassinamento automatico installato, versione" : iKey == 8 ? "Diagnostica MECALM: serrature visibili idonee = " : iKey == 9 ? ", scassinatori disponibili = " : iKey == 10 ? "ATTIVO" : iKey == 11 ? "DISATTIVO" : iKey == 12 ? "Questa serratura la scassino io!" : iKey == 13 ? "Gestore dello scassinamento automatico" : iKey == 14 ? "Scassinamento automatico" : iKey == 15 ? "Attivo" : iKey == 16 ? "Raggio di ricerca (1-100 m)" : iKey == 17 ? "Intervallo visuale/incarichi (0.1-6 s)" : iKey == 18 ? "Richiedi linea di vista" : iKey == 19 ? "Impedisci attacchi alle serrature in uso" : iKey == 20 ? "Evidenzia in grigio le serrature rilevate" : iKey == 21 ? "Messaggi sopra i compagni" : iKey == 22 ? "Output di debug" : iKey == 23 ? "Modalità Rilevamento automatica" : iKey == 24 ? "Intervallo controllo movimento (0.1-6 s)" : iKey == 25 ? "Ritardo da fermo (0.1-30 s)" : iKey == 26 ? "Salva" : iKey == 27 ? "Annulla" : iKey == 28 ? "Valore non valido. Usa gli intervalli indicati." : iKey == 29 ? "Impostazioni MECALM salvate." : "";
    SetLocalString(OBJECT_SELF, "MECALM_TEXT_RESULT", sText);
}
