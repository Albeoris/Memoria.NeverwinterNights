{
  "schema": 1,
  "id": "MEIO",
  "bootstrapper": {
    "heartbeat": "meio_hb",
    "priority": 400
  },
  "configuration": {
    "name": "Inventory Organizer",
    "name_key": "mod_display_name",
    "apply": "meio_apply",
    "localization": {
      "prefix": "meio"
    },
    "options": [
      {
        "type": "choice",
        "scope": "player",
        "local": "MEIO_CFG_SORT_MODE",
        "label": "Item storage mode",
        "label_key": "sort_mode_label",
        "tooltip": "Automatically store every acquired scroll and potion, or only store them when requested from the Spatial Storage window.",
        "tooltip_key": "sort_mode_tooltip",
        "choices": [
          {
            "value": 0,
            "label": "Automatic",
            "label_key": "sort_mode_automatic"
          },
          {
            "value": 1,
            "label": "Only on request",
            "label_key": "sort_mode_manual"
          }
        ]
      },
      {
        "type": "int",
        "scope": "player",
        "local": "MEIO_CFG_UI_SCALE",
        "label": "Item scale (%)",
        "label_key": "ui_scale_label",
        "tooltip": "Sets the size of spell entries in Spatial Storage. Allowed range: 25-100%. The default is 75%.",
        "tooltip_key": "ui_scale_tooltip",
        "minimum": 25,
        "maximum": 100
      },
      {
        "type": "bool",
        "scope": "player",
        "local": "MEIO_CFG_DEBUG",
        "label": "Debug messages",
        "label_key": "debug_label",
        "tooltip": "Writes detailed Scriptorium transfer tracing to the character chat and nwengineLog.txt.",
        "tooltip_key": "debug_tooltip"
      }
    ]
  }
}
