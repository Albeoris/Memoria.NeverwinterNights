{
  "screen": { "width": 1920, "height": 1080, "uiScale": 2.0 },
  "window": { "logicalWidth": 760, "logicalHeight": 500, "titleHeight": 24, "padding": 8 },
  "root": {
    "id": "spatial-storage-scale-25",
    "type": "column",
    "children": [
      { "id": "tabs", "type": "control", "height": 30 },
      { "id": "command-hint", "type": "control", "height": 22 },
      { "id": "search", "type": "control", "height": 30 },
      { "id": "filters", "type": "control", "height": 30 },
      {
        "id": "spell-list",
        "type": "list",
        "height": 307,
        "rowHeight": 24,
        "sampleRows": 10,
        "scrollbars": "both",
        "cells": [
          {
            "id": "row-widget",
            "width": 20.5,
            "child": {
              "id": "row-layout",
              "type": "row",
              "width": 20.5,
              "height": 24,
              "children": [
                { "id": "level", "type": "control", "width": 8.5, "height": 24 },
                {
                  "id": "spell",
                  "type": "group",
                  "width": 12,
                  "height": 23,
                  "borderInset": 0,
                  "child": {
                    "id": "spell-content",
                    "type": "column",
                    "width": 12,
                    "height": 23,
                    "children": [
                      { "id": "icon", "type": "control", "width": 11, "height": 11 },
                      { "id": "quantity", "type": "control", "width": 12, "height": 12 }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      { "id": "footer", "type": "control", "height": 32 }
    ]
  }
}
