{
  "screen": { "width": 3440, "height": 1440, "uiScale": 2.0 },
  "window": { "logicalWidth": 760, "logicalHeight": 500, "titleHeight": 24, "padding": 8 },
  "root": {
    "id": "spatial-storage-books",
    "type": "column",
    "children": [
      { "id": "tabs", "type": "control", "height": 30 },
      { "id": "command-hint", "type": "control", "height": 22 },
      {
        "id": "search",
        "type": "row",
        "height": 30,
        "children": [
          { "id": "search-label", "type": "control", "width": 70, "height": 30 },
          { "id": "search-input", "type": "control", "grow": 1, "height": 30 },
          { "id": "english-names", "type": "control", "width": 205, "height": 30 }
        ]
      },
      {
        "id": "book-grid",
        "type": "shelf",
        "height": 337,
        "unit": 52,
        "scroll": true,
        "items": [
          { "id": "book-1", "width": 1, "height": 1 },
          { "id": "book-2", "width": 1, "height": 1 },
          { "id": "book-3", "width": 1, "height": 1 },
          { "id": "book-4", "width": 1, "height": 1 },
          { "id": "book-5", "width": 1, "height": 1 },
          { "id": "book-6", "width": 1, "height": 1 },
          { "id": "book-7", "width": 1, "height": 1 },
          { "id": "book-8", "width": 1, "height": 1 },
          { "id": "book-9", "width": 1, "height": 1 },
          { "id": "book-10", "width": 1, "height": 1 },
          { "id": "book-11", "width": 1, "height": 1 },
          { "id": "book-12", "width": 1, "height": 1 }
        ]
      },
      { "id": "footer", "type": "control", "height": 32 }
    ]
  }
}
