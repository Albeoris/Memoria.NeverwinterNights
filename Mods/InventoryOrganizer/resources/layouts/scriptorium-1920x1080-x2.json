{
  "screen": { "width": 1920, "height": 1080, "uiScale": 2.0 },
  "window": { "logicalWidth": 760, "logicalHeight": 500, "titleHeight": 24, "padding": 8 },
  "root": {
    "id": "spatial-storage",
    "type": "column",
    "children": [
      {
        "id": "tabs",
        "type": "control",
        "height": 30
      },
      {
        "id": "command-hint",
        "type": "control",
        "height": 22
      },
      {
        "id": "search",
        "type": "control",
        "height": 30
      },
      {
        "id": "filters",
        "type": "control",
        "height": 30
      },
      {
        "id": "spell-list",
        "type": "list",
        "height": 307,
        "rowHeight": 53,
        "sampleRows": 5,
        "scrollbars": "both",
        "cells": [
          {
            "id": "row-widget",
            "width": 215.5,
            "grow": 1,
            "child": {
              "id": "row-layout",
              "type": "row",
              "height": 53,
              "gap": 2,
              "children": [
                { "id": "level", "type": "control", "width": 25.5, "height": 53 },
                {
                  "id": "spell-0",
                  "type": "group",
                  "width": 36,
                  "height": 51,
                  "borderInset": 0,
                  "child": {
                    "id": "spell-0-content",
                    "type": "column",
                    "width": 36,
                    "height": 51,
                    "children": [
                      { "id": "icon", "type": "control", "width": 33, "height": 33 },
                      { "id": "quantity", "type": "control", "width": 36, "height": 18 }
                    ]
                  }
                },
                { "id": "spell-1", "type": "control", "width": 36, "height": 51 },
                { "id": "spell-2", "type": "control", "width": 36, "height": 51 },
                { "id": "spell-3", "type": "control", "width": 36, "height": 51 },
                { "id": "spell-4", "type": "control", "width": 36, "height": 51 }
              ]
            }
          }
        ]
      },
      {
        "id": "footer",
        "type": "control",
        "height": 32
      }
    ]
  }
}
