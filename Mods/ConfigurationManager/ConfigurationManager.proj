<Project DefaultTargets="Build">
    <Import Project="..\..\Directory.Build.props" />
    <PropertyGroup>
        <ModId>MECONFIG</ModId>
        <Version>1.3.4</Version>
        <ModDisplayName>Memoria: Configuration Manager</ModDisplayName>
    </PropertyGroup>
    <PropertyGroup Label="Steam Workshop">
        <WorkshopPublishedFileId>3803402964</WorkshopPublishedFileId>
        <WorkshopTags>override;singleplayer;script</WorkshopTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Tools\Toolset\Memoria.NeverwinterNights.Toolset.csproj" />
        <NwnSource Include="source\**\*.nss" />
        <NwnResource Include="resources\**\*" Exclude="resources\layouts\**\*;resources\**\.gitkeep" />
        <NwnLayout Include="resources\layouts\**\*.json" />
        <PackageDocument Include="*.md" />
        <NwnRequiredPackage Include="..\Memoria\Memoria.proj" ModId="MEMORIA" Versions="[1.5.0,2.0.0)" PackageName="Memoria" />
        <NwnRequiredPackage Include="..\EventScriptInjector\EventScriptInjector.proj" ModId="esi" Versions="[2.2.1,3.0.0)" PackageName="Event Script Injector (Memoria Edition)" />
    </ItemGroup>
    <Import Project="..\..\Build\NwnModProject.targets" />
</Project>
