<Project DefaultTargets="Build">
    <Import Project="..\..\Directory.Build.props" />
    <PropertyGroup>
        <ModId>MECM</ModId>
        <Version>1.2.7</Version>
        <PackageId>mecm</PackageId>
        <PackageDisplayName>Memoria Companion Manager (MECM)</PackageDisplayName>
    </PropertyGroup>
    <PropertyGroup Label="Steam Workshop">
        <!-- Set this to the ID of the existing Workshop item. Leaving it empty prevents accidental item creation. -->
        <WorkshopPublishedFileId />
        <!-- SteamCMD cannot apply tags; keep this value in sync with the category selected on the Workshop page. -->
        <WorkshopTags>override</WorkshopTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Tools\Toolset\Memoria.NeverwinterNights.Toolset.csproj" />
        <NwnSource Include="source\**\*.nss" />
        <NwnResource Include="resources\**\*" Exclude="resources\**\.gitkeep" />
        <PackageDocument Include="*.md" />
        <NwnRequiredPackage Include="..\Memoria\Memoria.proj" ModId="MEMORIA" MinimumVersion="1.0.0" PackageName="Memoria" />
        <NwnRequiredPackage Include="..\EventScriptInjector\EventScriptInjector.proj" ModId="esi" MinimumVersion="1.0.0" PackageName="Event Script Injector (Memoria Edition)" />
        <NwnRequiredPackage Include="..\Configuration\Configuration.proj" ModId="MEMORIA_CONFIG" MinimumVersion="1.0.0" PackageName="Memoria Configuration Manager" />
    </ItemGroup>
    <Import Project="..\..\Build\NwnModProject.targets" />
</Project>
