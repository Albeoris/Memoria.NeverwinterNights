{
  "schema": 1,
  "id": "MECM",
  "bootstrapper": {
    "heartbeat": "mecm_hb",
    "priority": 200
  },
  "configuration": {
    "name": "Companion Manager",
    "name_key": "mod_display_name",
    "localization": {
      "prefix": "mecm"
    },
    "apply": "mecm_cfgapply",
    "diagnostic": "mecm_cfgdiag",
    "options": [
      {
        "type": "bool",
        "scope": "player",
        "local": "MECM_MODE_ENABLED",
        "label": "Automatic lockpicking",
        "label_key": "auto_lockpicking_option_label"
      },
      {
        "type": "float",
        "scope": "player",
        "local": "MECM_CFG_SEARCH_RADIUS",
        "label": "Search radius",
        "label_key": "search_radius_label",
        "minimum": 1,
        "maximum": 100
      },
      {
        "type": "float",
        "scope": "player",
        "local": "MECM_CFG_LOCK_INTERVAL",
        "label": "Lock interval",
        "label_key": "lock_interval_label",
        "minimum": 0.1,
        "maximum": 6
      },
      {
        "type": "bool",
        "scope": "player",
        "local": "MECM_CFG_REQUIRE_LOS",
        "label": "Require line of sight",
        "label_key": "require_los_label"
      },
      {
        "type": "bool",
        "scope": "player",
        "local": "MECM_CFG_ATTACK_SAFETY",
        "label": "Prevent attacks on worked locks",
        "label_key": "attack_safety_label"
      },
      {
        "type": "bool",
        "scope": "player",
        "local": "MECM_CFG_HIGHLIGHT",
        "label": "Highlight targets",
        "label_key": "highlight_label"
      },
      {
        "type": "bool",
        "scope": "player",
        "local": "MECM_CFG_OVERHEAD_MESSAGES",
        "label": "Show overhead messages",
        "label_key": "overhead_messages_label"
      },
      {
        "type": "bool",
        "scope": "player",
        "local": "MECM_CFG_DEBUG",
        "label": "Enable diagnostics",
        "label_key": "debug_output_label"
      }
    ]
  }
}
