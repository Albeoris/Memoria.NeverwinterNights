<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Memoria.NeverwinterNights.Toolset</RootNamespace>
    <AssemblyName>Memoria.NeverwinterNights.Toolset</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Copyright>Copyright (c) Albeoris</Copyright>
  </PropertyGroup>
  <!-- artifacts/api-cache is intentionally persistent and must survive Clean. -->
  <Target Name="CleanRepositoryArtifacts" AfterTargets="Clean" Condition="Exists('$(RepositoryRoot)artifacts')">
    <ItemGroup>
      <_ArtifactDirectory Include="$(CommonOutputPath);$(CommonOutputManifestPath);$(RepositoryRoot)artifacts\nwn-user" />
      <_ArtifactFile Include="$(RepositoryRoot)artifacts\*" />
      <_ConfigurationIntermediateDirectory Include="$([System.IO.Directory]::GetDirectories('$(BaseIntermediateOutputPath)'))" Condition="Exists('$(BaseIntermediateOutputPath)')" />
    </ItemGroup>
    <RemoveDir Directories="@(_ArtifactDirectory);$(BaseOutputPath);@(_ConfigurationIntermediateDirectory)" />
    <Delete Files="@(_ArtifactFile)" />
  </Target>
  <Target Name="PrepareCommonOutput" BeforeTargets="Build" Condition="'$(CommonOutput)' == 'true'">
    <RemoveDir Directories="$(CommonOutputPath);$(CommonOutputManifestPath)" />
    <Delete Files="$(CommonOutputLockFile)" />
    <MakeDir Directories="$(CommonOutputPath);$(CommonOutputManifestPath)" />
  </Target>
</Project>
